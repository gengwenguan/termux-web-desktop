# Web Desktop 登录凭据与会话密钥（示例）
# 用法：
#   cp auth.env.example auth.env   然后按下方说明填入真实值
#
# 生成密码哈希（在 Termux/任意有 werkzeug 的环境）：
#   python3 -c "from werkzeug.security import generate_password_hash as g; print(g('你的密码'))"
# 生成随机会话密钥：
#   python3 -c "import secrets; print(secrets.token_hex(32))"

WEB_USERNAME='webdesk'
WEB_PASSWORD_HASH='scrypt:32768:8:1$REPLACE_WITH_YOUR_HASH'
SESSION_SECRET='REPLACE_WITH_RANDOM_HEX'
